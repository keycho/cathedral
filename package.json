{
  "name": "kodo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "a voxel world grown by a market",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "market": "node server/index.js",
    "market:test": "node server/test.js",
    "monitor": "node scripts/monitor.mjs",
    "market:audit": "node -e \"import('./server/store.js').then(async m=>{const s=await m.openStore();const{audit}=await import('./server/reconcile.js');console.log(JSON.stringify(await audit(s),null,1))})\""
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "three": "^0.169.0"
  },
  "devDependencies": {
    "@types/three": "^0.169.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0"
  }
}
