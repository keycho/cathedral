# kodo - environment reference. copy nothing blindly: each variable below
# says which process reads it and where it is allowed to live. genesis is a
# config change, not a code change — the day the real token exists, KODO_MINT
# is set and the service stops announcing the stand-in.

# ---- the market service (railway / any node host) ---------------------------

# the token the indexer follows. UNSET means the stand-in: the service reads
# no chain, generates a synthetic ledger, and says so loudly on every start.
# set this to the real mint address at genesis and nothing else changes.
#KODO_MINT=

# when the world was founded. iso timestamp, millisecond epoch, or relative
# ("-90m" = ninety minutes ago, which is how a stand-in world is given a
# past). unset means: founded the first time the service starts.
#KODO_GENESIS=2026-08-17T00:00:00Z

# pool / trade source configuration is part of the same genesis change:
# the real adapter (HttpSource) replaces the stand-in inside openSource
# when KODO_MINT is set — see server/source.js.

# durable store. with supabase configured the log lives there; without it,
# a local json file (default .kodo/market.json).
#SUPABASE_URL=https://xxxx.supabase.co
# the SERVICE ROLE key. server-side only, set in the host's env (railway),
# NEVER in code, NEVER in any VITE_ variable, never shipped to a browser.
#SUPABASE_SERVICE_ROLE=
#KODO_STORE=.kodo/market.json

# http port and indexer cadence
#PORT=8787
#INDEX_INTERVAL_MS=10000

# ---- the client (vercel build env) ------------------------------------------
# everything prefixed VITE_ is baked into the public bundle at build time.
# nothing secret may ever carry this prefix.

# where the market service lives. unset = the world runs synthetic and
# single-visitor, exactly as before phase 2.
#VITE_MARKET_URL=https://cathedral-production.up.railway.app

# the witness layer's supabase read path. the anon key is publishable by
# design: row-level security lets it read the public log and nothing else.
# both default to the project's own values in src/witness.ts; set these only
# to point a build at a different database.
#VITE_SUPABASE_URL=https://xxxx.supabase.co
#VITE_SUPABASE_ANON_KEY=sb_publishable_...
